# Copy to .env for local development. Never commit the real .env.
# All values here are placeholders — see docs/SECURITY.md §66.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (docs/DATABASE_DESIGN.md)
DATABASE_URL=postgres://mds_rebar:mds_rebar@localhost:5432/mds_rebar

# Set to True only for quick local checks without a running Postgres —
# never in test/staging/production.
USE_SQLITE_FOR_LOCAL_DEV=False

# Redis (cache + Celery broker/result backend)
REDIS_URL=redis://localhost:6379/0

# CORS / CSRF — the frontend origin(s) allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Session / CSRF cookies (docs/SECURITY.md). Leave False for plain-HTTP
# local dev; staging/production force these True regardless.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_AGE=43200

# Per-account brute-force lockout (apps.accounts). After THRESHOLD failed
# logins the account locks for BASE_SECONDS, doubling each further failure
# up to MAX_SECONDS.
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_BASE_SECONDS=60
AUTH_LOCKOUT_MAX_SECONDS=3600

# Where password-reset links point (React admin route). 24h token TTL.
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_TIMEOUT=86400

# Object storage abstraction (docs/FILE_STORAGE.md): local | s3 | azure | gcs
STORAGE_PROVIDER=local
STORAGE_PUBLIC_BUCKET=
STORAGE_PRIVATE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT_URL=

# Email (password-reset in apps.accounts + apps.notifications; failures are
# logged/retried, never fatal). Base defaults to the console backend;
# set EMAIL_BACKEND to the SMTP backend once EMAIL_HOST is real.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@mdsrebar.example

# Error tracking (production only)
SENTRY_DSN=
