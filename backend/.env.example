# Copy to .env for local development. Never commit the real .env.
# All values here are placeholders — see docs/SECURITY.md §66.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (docs/DATABASE_DESIGN.md)
DATABASE_URL=postgres://mds_rebar:mds_rebar@localhost:5432/mds_rebar

# Set to True only for quick local checks without a running Postgres —
# never in test/staging/production.
USE_SQLITE_FOR_LOCAL_DEV=False

# Redis (cache + Celery broker/result backend)
REDIS_URL=redis://localhost:6379/0

# CORS / CSRF — the frontend origin(s) allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Security headers (config.security). Roll CSP out in report-only mode in
# a new environment, watch the reports, then set False to enforce.
CSP_REPORT_ONLY=False

# Baseline API rate limits (per IP for anon, per user otherwise). The
# sensitive flows keep their own tighter per-scope throttles.
THROTTLE_ANON=120/min
THROTTLE_USER=600/min

# Session / CSRF cookies (docs/SECURITY.md). Leave False for plain-HTTP
# local dev; staging/production force these True regardless.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_AGE=43200

# Per-account brute-force lockout (apps.accounts). After THRESHOLD failed
# logins the account locks for BASE_SECONDS, doubling each further failure
# up to MAX_SECONDS.
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_BASE_SECONDS=60
AUTH_LOCKOUT_MAX_SECONDS=3600

# Where password-reset links point (React admin route). 24h token TTL.
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_TIMEOUT=86400

# Document storage (docs/FILE_STORAGE.md). Dev/test use the local signed
# backend; production points this at the S3 backend and sets
# STORAGES["default"] (django-storages) via its own env.
DOCUMENT_STORAGE_BACKEND=apps.documents.storage.LocalSignedStorage
DOCUMENT_DOWNLOAD_URL_TTL=300
DOCUMENT_UPLOAD_URL_TTL=900
RESUME_UPLOAD_MAX_BYTES=5242880

# Search (docs/SEARCH.md): auto picks Postgres FTS on PostgreSQL, the
# icontains fallback elsewhere. Force with "postgres" / "simple".
SEARCH_PROVIDER=auto

# Internal inbox addresses for public-form alerts (apps.notifications).
# Empty = no internal alert; the requester acknowledgement still sends.
CAREERS_NOTIFICATION_EMAIL=
SALES_NOTIFICATION_EMAIL=

# Email (password-reset in apps.accounts + apps.notifications; failures are
# logged/retried, never fatal). Base defaults to the console backend;
# set EMAIL_BACKEND to the SMTP backend once EMAIL_HOST is real.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@mdsrebar.example

# Error tracking (production only)
SENTRY_DSN=
